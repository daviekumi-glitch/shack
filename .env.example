# SHACK configuration. Copy to .env and fill in your key.
#   cp .env.example .env

# Required. Free key: https://console.groq.com/keys
GROQ_KEY=

# Model. openai/gpt-oss-20b is fast and good at tool calling.
SHACK_MODEL=openai/gpt-oss-20b

# Speak replies out loud (termux-tts-speak)
SHACK_VOICE_OUT=true
# rumi (warm, soft), nova, sage, orion, system
SHACK_VOICE=rumi

# Start with the microphone on instead of typing
SHACK_VOICE_IN=false

# Hands free mode: python shack.py --wake
SHACK_WAKE_WORD=hey shack

# Refuse destructive shell commands
SHACK_SAFE_MODE=true

# Where memory, tasks and reminders are stored
SHACK_DATA_DIR=~/.shack
